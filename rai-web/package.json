{
  "name": "@rai/root",
  "version": "0.0.0",
  "private": true,
  "description": "RAI review desk product build (ADR-0003, D04). Every npm command runs from this directory; see docs/engineering/implementation-plan-w1-w3.md section 3.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "shared",
    "server",
    "web",
    "fixtures",
    "tests"
  ],
  "scripts": {
    "db:up": "cd .. && docker compose -p ${COMPOSE_PROJECT_NAME:-rai-dev} up -d --wait",
    "db:down": "cd .. && docker compose -p ${COMPOSE_PROJECT_NAME:-rai-dev} down -v",
    "migrate": "tsx --conditions=rai-source server/src/db/migrate.ts",
    "migrate:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "fixtures:generate": "tsx --conditions=rai-source fixtures/src/generate.ts",
    "fixtures:load": "tsx --conditions=rai-source fixtures/src/load.ts",
    "fixtures:eval:generate": "tsx --conditions=rai-source fixtures/src/evaluation/generate.ts",
    "reset": "npm run db:down && node scripts/remove-local.mjs && npm run db:up && npm run migrate && npm run fixtures:load",
    "db:cleanup": "tsx --conditions=rai-source server/src/operator/db-cleanup.ts",
    "store:verify": "tsx --conditions=rai-source server/src/operator/store-verify.ts",
    "store:cleanup": "tsx --conditions=rai-source server/src/operator/store-cleanup.ts",
    "backup": "tsx --conditions=rai-source server/src/operator/backup.ts",
    "restore": "tsx --conditions=rai-source server/src/operator/restore.ts",
    "restore:verify": "tsx --conditions=rai-source server/src/operator/restore-verify.ts",
    "release:check-rollback": "tsx --conditions=rai-source server/src/operator/rollback-check.ts",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w shared && npm run build -w web && npm run build -w server",
    "start": "node server/dist/main.js",
    "check:substitute-absent": "node scripts/check-substitute-absent.mjs",
    "test:unit": "NODE_ENV=test RAI_IDENTITY_MODE=fixture node --import tsx --conditions=rai-source --test 'server/src/**/*.test.ts' 'shared/src/**/*.test.ts' 'web/src/**/*.test.ts' 'fixtures/src/**/*.test.ts' 'tests/performance/*.test.ts' 'tests/rehearsal/*.test.ts' 'tests/evaluation/*.test.ts'",
    "test:integration": "NODE_ENV=test RAI_IDENTITY_MODE=fixture node --import tsx --conditions=rai-source --test --test-concurrency=1 'tests/integration/**/*.test.ts'",
    "test": "npm run test:unit && npm run test:integration",
    "test:browser": "npm run test:browser:server && npm run test:browser:substitute",
    "test:browser:server": "NODE_ENV=test RAI_IDENTITY_MODE=fixture playwright test -c tests/browser/playwright.config.ts",
    "test:browser:substitute": "NODE_ENV=test playwright test -c tests/browser/playwright.substitute.config.ts",
    "eval:qc": "NODE_ENV=test node --import tsx --conditions=rai-source tests/evaluation/run.ts",
    "perf:run": "NODE_ENV=test node --import tsx --conditions=rai-source tests/performance/run.ts",
    "lint": "eslint . && prettier --check . && node scripts/check-css.mjs",
    "lint:fix": "eslint --fix . && prettier --write .",
    "typecheck": "tsc -b . tests/performance",
    "verify": "npm run lint && npm run typecheck && npm test",
    "verify:full": "npm run verify && npm run build && npm run check:substitute-absent && npm run test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
