# RAI review desk — local configuration sample (W0-02 section 5; created by W1-00).
# Copy to .env (gitignored). Placeholders only: no secret is ever committed. Networked and production
# identity, mail and store credentials come from the D10 custody mechanism (RAI_SECRET_SOURCE), never from .env.
# server/src/config.ts is the only file that reads process.env; a misconfiguration is a start-up failure, never a default.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
TRUST_PROXY=false

# Postgres (W0-04 roles). The port follows POSTGRES_PORT; per-ticket isolation uses 54320 + <ticket number>.
DATABASE_URL=postgres://rai_app:rai_app@127.0.0.1:54320/rai
DATABASE_MIGRATE_URL=postgres://rai_owner:rai_owner@127.0.0.1:54320/rai
DATABASE_OPERATOR_URL=postgres://rai_operator:rai_operator@127.0.0.1:54320/rai
POSTGRES_PORT=54320

# Backup and restore (W7-01, W7-02; W7 plan section 2). Read only by `npm run backup`, `restore` and `restore:verify`, never by the server.
# RAI_PG_TOOLS: `path` (pg_dump/pg_restore of the server's major version on PATH), `docker:<container>` or
# `docker-compose:<project>` (the tools run inside that Postgres container; refused under NODE_ENV=production).
# The password reaches the tool only as PGPASSWORD in its environment. In the docker modes the tools connect to
# 127.0.0.1:RAI_PG_CONTAINER_PORT inside the container (default 5432). BACKUP_DIR is refused inside the Git worktree
# anywhere other than under rai-web/.local/, so a dump cannot be committed.
RAI_PG_TOOLS=docker-compose:rai-dev
# RAI_PG_CONTAINER_PORT=5432
BACKUP_DIR=./.local/backups
# DATABASE_ADMIN_URL (W7-02): read only by `npm run restore` and `npm run restore:verify`, never by the server. A role
# with CREATEDB that can SET ROLE to rai_app and rai_owner; locally the compose superuser (synthetic credential).
DATABASE_ADMIN_URL=postgres://postgres:postgres-local@127.0.0.1:54320/postgres

# Private artifact store (W0-04) and upload limits (W0-08 section 3; D08 revisits before real data).
BLOB_DIR=./.local/blobs
UPLOAD_MAX_FILE_BYTES=26214400
UPLOAD_MAX_PACK_BYTES=157286400
UPLOAD_MAX_IMAGE_PIXELS=40000000
IDEMPOTENCY_TTL_HOURS=72
BLOB_ORPHAN_MIN_AGE_HOURS=24
BLOB_TMP_MAX_AGE_HOURS=1

# Identity (W0-03 owns these names). local-google is the L11 development login, loopback only.
# fixture is accepted only when NODE_ENV=test and the bind is loopback; the test commands set it themselves.
RAI_IDENTITY_MODE=local-google
RAI_IDENTITY_GOOGLE_CLIENT_ID=set-locally
RAI_IDENTITY_GOOGLE_CLIENT_SECRET=set-in-custody
RAI_IDENTITY_LOCAL_ROLE_MAP=
RAI_IDENTITY_NETWORK_SOURCE=allow-list
RAI_IDENTITY_OIDC_ISSUER_URL=https://issuer.example.test
RAI_IDENTITY_OIDC_CLIENT_ID=set-in-custody
RAI_IDENTITY_OIDC_CLIENT_SECRET=set-in-custody
RAI_IDENTITY_ALLOW_LIST_JSON=set-in-custody
RAI_IDENTITY_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
RAI_SECRET_SOURCE=env
RAI_SECRET_DIR=/run/secrets
RAI_SESSION_ABSOLUTE_HOURS=12
RAI_SESSION_IDLE_MINUTES=120

# Mail (W0-07): slice 1 has only the sink; no transport value exists until W7 authorizes one.
MAIL_MODE=sink-file
MAIL_SINK_DIR=./.local/mail

# QC (W0-07, W4a plan section 2): `deterministic` is the W4a metadata runner, valid in every environment. `substitute`
# (the scripted W1-10 runner) is refused under NODE_ENV=production or a non-local identity mode; the test harness
# and CI set it explicitly for the W2/W3 journeys.
QC_MODE=deterministic

# Observability (W0-10). LOG_PRETTY is refused when NODE_ENV=production and never set by the test commands.
LOG_LEVEL=info
LOG_PRETTY=true
BUILD_COMMIT=dev

# Real-server browser suite.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:8788
